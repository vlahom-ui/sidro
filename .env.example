# Supabase (zaseban projekt, ne dijeli se s dubrovnikgastro)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (zaseban site key za sidroapp.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (zasebna verifikacija domene sidroapp.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sidro <noreply@sidroapp.com>
ADMIN_NOTIFICATION_EMAIL=

# Javni URL aplikacije (koristi se za "Javna stranica" link na dashboardu,
# QR kod i sva mjesta koja grade apsolutni /c/{slug} URL)
NEXT_PUBLIC_SITE_URL=https://sidroapp.com
